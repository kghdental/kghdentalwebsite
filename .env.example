# =================================================================
# KGH Dental — Environment Variables Template
# Copy this file to .env.local for local development, or add these
# keys into Vercel Project Settings -> Environment Variables.
# =================================================================

# Supabase Cloud Database & Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-optional

# Server-Only Clinic Administration Credentials (NEVER expose to client)
ADMIN_EMAIL=admin@kghdental.com
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SECRET_KEY=generate-a-random-32-character-secret-key

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# SMTP / Gmail Notification Service (For Doctor & Clinic Email Alerts)
# Supports SMTP_EMAIL or GMAIL_USER
SMTP_EMAIL=your-clinic-notification@gmail.com
# Supports SMTP_PASSWORD or GMAIL_APP_PASSWORD (16-character Google App Password)
SMTP_PASSWORD=your-google-16-character-app-password
GMAIL_USER=your-clinic-notification@gmail.com
GMAIL_APP_PASSWORD=your-google-16-character-app-password
# Optional SMTP overrides:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM_NAME="KGH Dental Care"
NOTIFICATION_FALLBACK_EMAIL=care@kghdental.com
